# ---- Backend (server.ts) ----
PORT=3000
# Origem permitida no CORS (padrão: *). Ex.: https://localhost
CORS_ORIGIN=*

# (Opcional) Chave da REDEMET
REDEMET_API_KEY=""

# (Opcional) Chat via Supabase. Sem isso, usa o WebSocket nativo do servidor.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---- Frontend / APK ----
# URL pública do backend (https). Deixe vazio para web servida pelo próprio servidor.
# Para o APK, defina na hora do build: VITE_API_BASE=https://seu-backend.onrender.com
VITE_API_BASE=""
